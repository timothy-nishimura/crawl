{
    "name": "@crawl/mcp-server",
    "version": "1.0.0",
    "description": "MCP server exposing the crawl engine as tools.",
    "type": "module",
    "main": "./dist/index.js",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsc",
        "build:force": "tsc || true",
        "build:watch": "tsc --watch",
        "typecheck": "tsc --noEmit",
        "start": "node dist/index.js",
        "dev": "node --watch dist/index.js",
        "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
        "test:coverage": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --coverage"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "@crawl/engine": "file:../../core",
        "@crawl/extractors": "file:../extractors",
        "@crawl/tls-backend": "file:../tls-backend",
        "@modelcontextprotocol/sdk": "^1.10.0",
        "cheerio": "^1.2.0",
        "express": "^4.19.2",
        "playwright": "^1.60.0",
        "playwright-core": "^1.60.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.14.0",
        "cross-env": "^10.1.0",
        "typescript": "^5.4.5"
    }
}
